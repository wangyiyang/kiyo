# OAuth 社交登录
# 需在 Supabase Dashboard > Authentication > Providers 中开启对应 Provider
# GitHub: https://supabase.com/docs/guides/auth/social-login/auth-github
# Google: https://supabase.com/docs/guides/auth/social-login/auth-google
NEXT_PUBLIC_SITE_URL=https://kiyo.wangyiyang.cc

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://cgqorvwsnuiqtoxzwymr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 旧项目如果仍显示 anon public key，可使用这个 fallback
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Minimax AI（音乐生成、封面生成、翻唱）
MINIMAX_API_KEY=

# GMI Cloud AI（歌词生成等文本任务）
GMI_API_KEY=
# GMI_BASE_URL=https://api.gmi-serving.com
# GMI_DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Flash

# AI 提供商配置（每类任务可独立指定：minimax | gmi）
# 默认：lyrics/text 走 GMI Cloud，image/music/cover 走 Minimax
# PROVIDER_LYRICS=gmi
# PROVIDER_TEXT=gmi
# PROVIDER_IMAGE=minimax
# PROVIDER_MUSIC=minimax
# PROVIDER_COVER=minimax

# Supabase Service Role Key（仅服务端使用，用于删除账户）
SUPABASE_SERVICE_ROLE_KEY=

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
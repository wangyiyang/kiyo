  "features": {
    "eyebrow": "产品能力",
    "heading": "为创作者重新设计的 AI 工作流",
    "description": "不只是生成，而是协作。让 AI 成为你的乐队成员，而不是一个按钮。",
    "items": {
      "multiModel": {
        "title": "多模型协同",
        "description": "顶尖音乐与语言模型在同一条时间线上接力 —— 灵感、旋律、人声、混音各司其职，由你统一指挥。"
      },
      "controllable": {
        "title": "可控的创作过程",
        "description": "不是一键黑盒。歌词、调式、流派、人声、节奏与停顿都开放给你 —— 想要 SUNO 般洒脱，还是制作人级精修，都能精确控制。"
      },
      "endToEnd": {
        "title": "从灵感到成品",
        "description": "一条工作流：草稿、协作编辑、版本历史、封面与歌词管理、导出与发布。不再在十个工具之间来回切换。"
      }
    }
  },
  "howItWorks": {
    "eyebrow": "工作流",
    "heading": "四步，从灵感到发布",
    "description": "每一步都让创作者驱动 —— 而不是被流程拖着走。",
    "steps": {
      "describe": {
        "step": "01",
        "title": "描述灵感",
        "description": "一句歌词、一张图、一种情绪。Kiyo 会转化成流派、情感与段落结构。"
      },
      "generate": {
        "step": "02",
        "title": "协同生成",
        "description": "多个模型并行起草 —— 主歌、副歌、桥段并排呈现。挑一个，Kiyo 接着往下走。"
      },
      "refine": {
        "step": "03",
        "title": "精修与人声",
        "description": "调速度、变调式、换音色、叠加 AI 人声 —— 男声、女声、咬字方式都可指挥。"
      },
      "release": {
        "step": "04",
        "title": "混音与发布",
        "description": "一键母带，导出无损或流媒体规格 —— 灵感到成品只要几分钟。"
      }
    }
  },

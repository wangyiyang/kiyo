  "features": {
    "eyebrow": "What it does",
    "heading": "An AI workflow rebuilt for creators",
    "description": "Not just generation — collaboration. Make AI a bandmate, not a button.",
    "items": {
      "multiModel": {
        "title": "Multi-model collaboration",
        "description": "Top music and language models hand off work along one timeline — inspiration, melody, vocals, and mixing each play their part while you conduct."
      },
      "controllable": {
        "title": "A controllable process",
        "description": "Not a one-click black box. Lyrics, key, genre, AI cover styles, vocals, rhythm, and pauses are all exposed — go SUNO-loose or producer-tight, your call."
      },
      "endToEnd": {
        "title": "Spark to finished track",
        "description": "One workflow: drafts, collaborative edits, version history, cover and lyric management, export and release. No more juggling ten tools."
      }
    }
  },
  "howItWorks": {
    "eyebrow": "Workflow",
    "heading": "Four steps from spark to release",
    "description": "Every step keeps the creator driving — never dragged along by the pipeline.",
    "steps": {
      "describe": {
        "step": "01",
        "title": "Describe the spark",
        "description": "A line of lyrics, an image, a mood. Kiyo turns it into genre, emotion, and section structure."
      },
      "generate": {
        "step": "02",
        "title": "Co-generate",
        "description": "Multiple models draft in parallel — verse, chorus, and bridge variants side by side. Pick one and Kiyo carries on."
      },
      "refine": {
        "step": "03",
        "title": "Refine and voice",
        "description": "Adjust tempo, modulate keys, swap timbres, layer AI covers and vocals — male, female, articulation style, all directable."
      },
      "release": {
        "step": "04",
        "title": "Mix and release",
        "description": "One-click mastering, export lossless or streaming-ready — spark to live track in minutes."
      }
    }
  },
